# ===== ฐานข้อมูล (จำเป็น) =====
# PostgreSQL connection string — ห้าม commit ค่าจริง
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lotto?schema=public"

# ===== Scheduled sync (จำเป็นสำหรับการอัปเดตอัตโนมัติ) =====
# สุ่มค่ายาว ๆ เช่น: openssl rand -hex 32
# Vercel Cron / GitHub Actions / cron ภายนอก ต้องส่ง Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# URL สาธารณะของเว็บ (ใช้กับ SEO / sitemap)
NEXT_PUBLIC_SITE_URL="https://your-domain.example"

# ===== ไม่บังคับ =====
# ป้องกันทั้งเว็บด้วย Basic Auth (ชื่อผู้ใช้ใดก็ได้ + รหัสผ่านนี้)
SITE_PASSWORD=""
# จำนวนงวดสูงสุดที่ยืนยันกับ GLO ต่อการซิงก์ 1 ครั้ง (ค่าเริ่มต้น 12)
VERIFY_MAX_PER_RUN="12"
# วินาทีขั้นต่ำระหว่างการกด "อัปเดตข้อมูล" หลังซิงก์สำเร็จ (ค่าเริ่มต้น 120)
MANUAL_SYNC_COOLDOWN_SECONDS="120"
# ช่วงเวลาตรวจของ npm run scheduler (นาที)
SYNC_INTERVAL_MINUTES="45"
# User-Agent ที่ใช้ดึงข้อมูล
# FETCH_USER_AGENT="LottoIntelligenceBot/1.0 (+https://your-domain.example/about)"

# ===== โหมดสาธิต =====
# ใช้กับฐานข้อมูลแยกที่ชื่อมีคำว่า demo เท่านั้น — ข้อมูลสุ่ม ไม่ใช่ผลจริง
DEMO_MODE="false"
